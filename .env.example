# Defaults already set; change only if hosting requires a dedicated provider hostname.
HOST=127.0.0.1
PORT=8000
BINANCE_REST=https://data-api.binance.vision
BINANCE_WS=wss://data-stream.binance.vision:443
BIQUOTE_REST=https://biquote.io
BIQUOTE_HUB=https://biquote.io/hubs/tick

# Set at deployment using PRIVATE environment variables, not source control.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ALERT_ADMIN_TOKEN=
# Public HTTPS webhook receiver (e.g. a private automation gateway). NEVER put tokens in the URL.
ALERT_WEBHOOK_URL=
# HMAC signing key for X-Lumavun-Signature-256, ideally random and different from admin token.
ALERT_WEBHOOK_SECRET=
# Durable server-side JSON store. Mount persistent volume for cloud deployments.
ALERT_STORE_PATH=./data/alerts.json
